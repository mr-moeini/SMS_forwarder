<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etName"
            style="@style/IOSField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/rule_name_hint"
            android:inputType="text" />

        <TextView
            style="@style/IOSSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sec_callers" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAllCalls"
            style="@style/IOSSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ca_all_calls"
            android:textColor="@color/ios_label"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/callersBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCallers"
                style="@style/IOSField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddContact"
                    style="@style/IOSTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ca_add_contact" />

                <Button
                    android:id="@+id/btnAddNumber"
                    style="@style/IOSTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ca_add_number" />

                <Button
                    android:id="@+id/btnClearCallers"
                    style="@style/IOSTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ca_clear" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/IOSSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sec_time" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swTime"
            style="@style/IOSSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ca_time_limit"
            android:textColor="@color/ios_label"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/timeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTimeFrom"
                style="@style/IOSField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvTimeTo"
                style="@style/IOSField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            style="@style/IOSSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sec_expiry" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swDate"
            style="@style/IOSSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ca_date_limit"
            android:textColor="@color/ios_label"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/dateBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDateFrom"
                style="@style/IOSField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/tvDateTo"
                style="@style/IOSField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            style="@style/IOSSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sec_message" />

        <TextView
            android:id="@+id/tvAudio"
            style="@style/IOSField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnChooseAudio"
                style="@style/IOSTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ca_choose_audio" />

            <Button
                android:id="@+id/btnRecord"
                style="@style/IOSTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ca_record" />

            <Button
                android:id="@+id/btnPlay"
                style="@style/IOSTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ca_play" />
        </LinearLayout>

        <TextView
            style="@style/IOSSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sec_delay" />

        <EditText
            android:id="@+id/etDelay"
            style="@style/IOSField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ca_delay"
            android:inputType="number"
            android:maxLength="2" />
    </LinearLayout>
</ScrollView>
