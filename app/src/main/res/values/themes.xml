<resources>
    <style name="Theme.SMSForwarder" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryVariant">@color/ios_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/ios_blue</item>
        <item name="colorAccent">@color/ios_blue</item>
        <item name="android:windowBackground">@color/ios_bg</item>
        <item name="android:statusBarColor">@color/ios_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:textColorPrimary">@color/ios_label</item>
        <item name="android:textColorSecondary">@color/ios_secondary</item>
        <item name="alertDialogTheme">@style/IOSAlertDialog</item>
    </style>

    <style name="IOSAlertDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/ios_label</item>
        <item name="android:textColorSecondary">@color/ios_secondary</item>
        <item name="colorAccent">@color/ios_blue</item>
        <item name="buttonBarButtonStyle">@style/IOSDialogButton</item>
    </style>

    <style name="IOSDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/ios_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="IOSField">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:textColorHint">@color/ios_secondary</item>
    </style>

    <style name="IOSSection">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/ios_secondary</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="IOSSwitch">
        <item name="thumbTint">@android:color/white</item>
        <item name="trackTint">@color/ios_switch_track</item>
        <item name="useMaterialThemeColors">false</item>
    </style>

    <style name="IOSTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Accent color themes: only colorPrimary (and the matching control colors) change. -->
    <style name="Theme.SMSForwarder.Green" parent="Theme.SMSForwarder">
        <item name="colorPrimary">#34C759</item>
        <item name="colorPrimaryVariant">#34C759</item>
        <item name="colorSecondary">#34C759</item>
        <item name="colorAccent">#34C759</item>
        <item name="colorControlActivated">#34C759</item>
    </style>

    <style name="Theme.SMSForwarder.Purple" parent="Theme.SMSForwarder">
        <item name="colorPrimary">#AF52DE</item>
        <item name="colorPrimaryVariant">#AF52DE</item>
        <item name="colorSecondary">#AF52DE</item>
        <item name="colorAccent">#AF52DE</item>
        <item name="colorControlActivated">#AF52DE</item>
    </style>

    <style name="Theme.SMSForwarder.Orange" parent="Theme.SMSForwarder">
        <item name="colorPrimary">#FF9500</item>
        <item name="colorPrimaryVariant">#FF9500</item>
        <item name="colorSecondary">#FF9500</item>
        <item name="colorAccent">#FF9500</item>
        <item name="colorControlActivated">#FF9500</item>
    </style>
</resources>
